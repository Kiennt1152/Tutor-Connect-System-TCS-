>>>>>>> Stashed changes

# ===== JWT Authentication =====
# REQUIRED: Generate a secure 256-bit secret key
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_min_256_bits_here

# ===== Google OAuth =====
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ===== Email / SMTP =====
# Gmail example (requires App Password):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_16_chars
MAIL_FROM=noreply@tutorconnect.com
MAIL_FROM_NAME=Tutor Connect System

# ===== AI API Keys =====
# Gemini API (for chatbot)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (fallback when Gemini rate limited)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ===== Optional: Development Settings =====
# Enable direct deposit for testing (default: false)
FINANCE_DEV_DIRECT_DEPOSIT_ENABLED=false

# Enable simulated top-up for testing (default: false)
FINANCE_DEV_SIMULATE_TOPUP_ENABLED=false

# Auto-approval threshold for withdrawals (default: 0 = manual review)
FINANCE_WITHDRAWAL_AUTO_APPROVAL_THRESHOLD=0
