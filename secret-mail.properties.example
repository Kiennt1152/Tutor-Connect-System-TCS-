# ============================================================================
#  CẤU HÌNH GỬI EMAIL (OTP) — FILE MẪU
# ============================================================================
#  Cách dùng (mỗi máy làm 1 lần):
#    1. Copy file này thành:  secret-mail.properties  (bỏ đuôi .example),
#       đặt ở THƯ MỤC GỐC project (ngang hàng backend/ và frontend/).
#         PowerShell:  Copy-Item secret-mail.properties.example secret-mail.properties
#    2. Điền 2 dòng bên dưới:
#         - MAIL_USERNAME: email Gmail dùng để gửi.
#         - MAIL_PASSWORD: App Password Gmail (16 ký tự, XOÁ hết dấu cách).
#           App Password chung do nhóm cấp, xin qua kênh riêng (KHÔNG qua Git),
#           hoặc tự tạo tại https://myaccount.google.com/apppasswords (cần bật 2FA).
#    3. Khởi động lại backend là gửi được OTP.
#
#  LƯU Ý: file secret-mail.properties THẬT đã được .gitignore -> KHÔNG commit.
#         Chỉ file .example này (không chứa mật khẩu thật) mới được đưa lên Git.
#         (Không cần điền MAIL_FROM — hệ thống tự lấy theo MAIL_USERNAME.)
# ============================================================================

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
# Bắt buộc = true để module hợp đồng gửi email OTP (mặc định false = tắt).
MAIL_ENABLED=true
